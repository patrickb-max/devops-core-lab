{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Isolated temporary DevOps lab. Dummy data only; database is ephemeral.",
  "Parameters": {
    "ApiImage": {
      "Type": "String"
    },
    "MongoImage": {
      "Type": "String"
    },
    "Version": {
      "Type": "String"
    },
    "AllowedCidr": {
      "Type": "String",
      "AllowedPattern": "([0-9]{1,3}\\.){3}[0-9]{1,3}/32",
      "ConstraintDescription": "One approved public IPv4 address with /32"
    },
    "AlertEmail": {
      "Type": "String",
      "Default": ""
    }
  },
  "Conditions": {
    "HasEmail": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AlertEmail"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.87.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "devops-practice-core"
          }
        ]
      }
    },
    "Gateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Project",
            "Value": "devops-practice-core"
          }
        ]
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "Routes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "devops-practice-core"
          }
        ]
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "Routes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Gateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "SubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.87.0.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "devops-practice-core"
          }
        ]
      }
    },
    "SubnetARoute": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "SubnetA"
        },
        "RouteTableId": {
          "Ref": "Routes"
        }
      }
    },
    "SubnetB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.87.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "devops-practice-core"
          }
        ]
      }
    },
    "SubnetBRoute": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "SubnetB"
        },
        "RouteTableId": {
          "Ref": "Routes"
        }
      }
    },
    "AlbSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "GroupDescription": "Practice HTTP from approved learner IPv4 only",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": {
              "Ref": "AllowedCidr"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "devops-practice-core"
          }
        ]
      }
    },
    "TaskSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "GroupDescription": "Practice API reachable only from practice ALB",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 3100,
            "ToPort": 3100,
            "SourceSecurityGroupId": {
              "Ref": "AlbSecurity"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "devops-practice-core"
          }
        ]
      }
    },
    "Alb": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Scheme": "internet-facing",
        "Type": "application",
        "Subnets": [
          {
            "Ref": "SubnetA"
          },
          {
            "Ref": "SubnetB"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "AlbSecurity"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "devops-practice-core"
          }
        ]
      }
    },
    "Targets": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Port": 3100,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "HealthCheckPath": "/health/ready",
        "HealthCheckIntervalSeconds": 15,
        "HealthCheckTimeoutSeconds": 5,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 2,
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "10"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "devops-practice-core"
          }
        ]
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "Alb"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "Targets"
            }
          }
        ]
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/devops-practice/core",
        "RetentionInDays": 7
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "PullLabImagesAndWriteLabLogs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/devops-practice-core"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/devops-practice-mongo"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Logs",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": "devops-practice-core",
        "Tags": [
          {
            "Key": "Project",
            "Value": "devops-practice-core"
          }
        ]
      }
    },
    "Task": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "devops-practice-core",
        "Cpu": "512",
        "Memory": "2048",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "mongo",
            "Image": {
              "Ref": "MongoImage"
            },
            "Essential": true,
            "Command": [
              "mongod",
              "--bind_ip",
              "127.0.0.1"
            ],
            "HealthCheck": {
              "Command": [
                "CMD",
                "mongosh",
                "--quiet",
                "--eval",
                "db.adminCommand({ping:1}).ok"
              ],
              "Interval": 10,
              "Timeout": 5,
              "Retries": 5,
              "StartPeriod": 30
            },
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "mongo"
              }
            }
          },
          {
            "Name": "core",
            "Image": {
              "Ref": "ApiImage"
            },
            "Essential": true,
            "DependsOn": [
              {
                "ContainerName": "mongo",
                "Condition": "HEALTHY"
              }
            ],
            "PortMappings": [
              {
                "ContainerPort": 3100,
                "Protocol": "tcp"
              }
            ],
            "Environment": [
              {
                "Name": "MONGODB_URI",
                "Value": "mongodb://127.0.0.1:27017"
              },
              {
                "Name": "HOST",
                "Value": "0.0.0.0"
              },
              {
                "Name": "ENABLE_DRILLS",
                "Value": "true"
              },
              {
                "Name": "APP_VERSION",
                "Value": {
                  "Ref": "Version"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "core"
              }
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "devops-practice-core"
          }
        ]
      }
    },
    "Service": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "ServiceName": "devops-practice-core",
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "Task"
        },
        "DesiredCount": 1,
        "LaunchType": "FARGATE",
        "HealthCheckGracePeriodSeconds": 120,
        "DeploymentConfiguration": {
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 0,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": [
              {
                "Ref": "SubnetA"
              },
              {
                "Ref": "SubnetB"
              }
            ],
            "SecurityGroups": [
              {
                "Ref": "TaskSecurity"
              }
            ]
          }
        },
        "LoadBalancers": [
          {
            "ContainerName": "core",
            "ContainerPort": 3100,
            "TargetGroupArn": {
              "Ref": "Targets"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "devops-practice-core"
          }
        ]
      },
      "DependsOn": [
        "Listener",
        "InternetRoute",
        "SubnetARoute",
        "SubnetBRoute"
      ]
    },
    "Alerts": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "TopicName": "devops-practice-core-alerts",
        "Tags": [
          {
            "Key": "Project",
            "Value": "devops-practice-core"
          }
        ]
      }
    },
    "Email": {
      "Type": "AWS::SNS::Subscription",
      "Properties": {
        "TopicArn": {
          "Ref": "Alerts"
        },
        "Protocol": "email",
        "Endpoint": {
          "Ref": "AlertEmail"
        }
      },
      "Condition": "HasEmail"
    },
    "ErrorMetric": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "Logs"
        },
        "FilterPattern": "{ $.statusCode >= 500 }",
        "MetricTransformations": [
          {
            "MetricNamespace": "DevopsPractice",
            "MetricName": "ServerErrors",
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "ErrorAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "devops-practice-core-server-errors",
        "Namespace": "DevopsPractice",
        "MetricName": "ServerErrors",
        "Statistic": "Sum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "Threshold": 2,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ],
        "OKActions": [
          {
            "Ref": "Alerts"
          }
        ]
      }
    },
    "DownAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "devops-practice-core-unhealthy",
        "Namespace": "AWS/ApplicationELB",
        "MetricName": "HealthyHostCount",
        "Dimensions": [
          {
            "Name": "LoadBalancer",
            "Value": {
              "Fn::GetAtt": [
                "Alb",
                "LoadBalancerFullName"
              ]
            }
          },
          {
            "Name": "TargetGroup",
            "Value": {
              "Fn::GetAtt": [
                "Targets",
                "TargetGroupFullName"
              ]
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 2,
        "Threshold": 1,
        "ComparisonOperator": "LessThanThreshold",
        "TreatMissingData": "breaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ],
        "OKActions": [
          {
            "Ref": "Alerts"
          }
        ]
      }
    },
    "Dashboard": {
      "Type": "AWS::CloudWatch::Dashboard",
      "Properties": {
        "DashboardName": "devops-practice-core",
        "DashboardBody": {
          "Fn::Sub": "{\"widgets\":[{\"type\":\"metric\",\"x\":0,\"y\":0,\"width\":12,\"height\":6,\"properties\":{\"title\":\"Practice API server errors\",\"region\":\"${AWS::Region}\",\"metrics\":[[\"DevopsPractice\",\"ServerErrors\"]],\"stat\":\"Sum\",\"period\":60}},{\"type\":\"metric\",\"x\":12,\"y\":0,\"width\":12,\"height\":6,\"properties\":{\"title\":\"Practice ECS CPU and memory\",\"region\":\"${AWS::Region}\",\"metrics\":[[\"AWS/ECS\",\"CPUUtilization\",\"ClusterName\",\"devops-practice-core\",\"ServiceName\",\"devops-practice-core\"],[\".\",\"MemoryUtilization\",\".\",\".\",\".\",\".\"]],\"period\":60}}]}"
        }
      }
    }
  },
  "Outputs": {
    "Url": {
      "Value": {
        "Fn::Sub": "http://${Alb.DNSName}"
      }
    },
    "Logs": {
      "Value": {
        "Ref": "Logs"
      }
    },
    "Cluster": {
      "Value": {
        "Ref": "Cluster"
      }
    },
    "AlarmTopic": {
      "Value": {
        "Ref": "Alerts"
      }
    }
  }
}